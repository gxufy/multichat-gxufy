# multichat-gxufy — environment variables
#
# Copy to .env.local for development. In production, values come from the
# deploy workflow's secrets via .github/infra/ecosystem.config.js. Names and formats only: this file is
# committed, so it must never contain a real value.
#
# Kick, Twitch, YouTube, TikTok, 7TV, BTTV, and FFZ chat rendering all work
# with channel names alone. The Twitch app credentials below are optional
# server-side credentials for Twitch API helpers; they are never sent to
# the browser.

# ---------------------------------------------------------------------------
# Twitch app API (optional)
# ---------------------------------------------------------------------------
# Twitch application client ID.
TWITCH_CLIENT_ID=

# Server-only secret for app access-token requests.
TWITCH_CLIENT_SECRET=
# ---------------------------------------------------------------------------
# Kick channel search (required in production)
# ---------------------------------------------------------------------------
# Search-only key for Kick's public channel search index (server-only).
KICK_TYPESENSE_SEARCH_KEY=

# ---------------------------------------------------------------------------
# TikTok (optional)
# ---------------------------------------------------------------------------
# Optional TikTok signing API key (Euler Stream) for the viewer counter's
# TikTok room lookups only. TikTok chat needs no key or signing service.
TIKTOK_SIGN_API_KEY=

# ---------------------------------------------------------------------------
# Private overlay-usage notifications (required in production)
# ---------------------------------------------------------------------------

# Server-only Discord webhook used by /api/overlay/usage. The browser sends
# only the overlay type, canonical configured channels, page-load event ID,
# navigation action, mode, and an optional shortened random instance ID.
# Never prefix this key with NEXT_PUBLIC_ and never commit its real value.
GXUFY_OVERLAY_USAGE_DISCORD_WEBHOOK_URL=

# Server-only webhook for private abuse-prevention alerts. Raw client IP
# addresses are sent only after repeated rate-limit rejections reach the
# abuse-alert threshold. Keep this webhook in a restricted private channel.
# Never prefix this key with NEXT_PUBLIC_ and never commit its real value.
GXUFY_ABUSE_DISCORD_WEBHOOK_URL=
# ---------------------------------------------------------------------------
# Private support-page preview (optional)
# ---------------------------------------------------------------------------

# Server-only feature flag. Leave blank in production to make /support
# return 404. Set to 1 only for an intentional private preview. Under
# `npm run dev` the page shows when this is not set at all.
# Never prefix this key with NEXT_PUBLIC_.
GXUFY_SUPPORT_PAGE_ENABLED=

# ---------------------------------------------------------------------------
# $5 supporter checkout (optional; needs the support page)
# ---------------------------------------------------------------------------

# PayPal REST app credentials (server-only). Sandbox unless PAYPAL_ENV=live,
# and live is refused unless GXUFY_PAYPAL_LIVE_APPROVED=1 is also set.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# GXUFY_PAYPAL_LIVE_APPROVED=

# PayPal webhook ID; enables refund/reversal handling (badge removal).
PAYPAL_WEBHOOK_ID=

# Where paid supporters are recorded: a SQLite database file (Node's built-in
# node:sqlite, Node 22.13+). Required in production (keep it outside the deploy
# folder, e.g. /home/ubuntu/flosschat-data/supporters.db); `npm run dev`
# defaults to .data/supporters.db. A daily copy is kept in a `backups` folder
# next to it (newest 14).
GXUFY_SUPPORTER_STORE_PATH=

# Optional Discord webhook: one message per completed purchase (Twitch name and
# ID, for themselves or gift, amount, order ID). No refund notices, no emails.
GXUFY_SUPPORTER_DISCORD_WEBHOOK_URL=

# Sign in with Twitch (/badges, "For you" on /support). Signs the session
# cookie; at least 32 random characters. Uses TWITCH_CLIENT_ID/SECRET above and
# the redirect URL https://<site>/api/twitch/oauth/callback on the Twitch app.
# Leave blank under `npm run dev` (a temporary key is made per dev server).
FLOSSCHAT_SESSION_SECRET=

# ---------------------------------------------------------------------------
# JilTV cosmetics (optional, off)
# ---------------------------------------------------------------------------

# Both must be 1 for JilTV paints/badges to show in the overlay.
NEXT_PUBLIC_GXUFY_JILTV_COSMETICS=
GXUFY_JILTV_COSMETICS_ENABLED=
