# multichat-gxufy — environment variables
#
# Copy to .env.local for development, or paste into the `env` block of
# ecosystem.config.js in production. Names and formats only: this file is
# committed, so it must never contain a real value.
#
# Kick, Twitch, YouTube, TikTok, 7TV, BTTV, and FFZ chat rendering all work
# with channel names alone. The Twitch app credentials below are optional
# server-side credentials for Twitch API helpers; they are never sent to
# the browser.

# ---------------------------------------------------------------------------
# Twitch app API (optional)
# ---------------------------------------------------------------------------

# From https://dev.twitch.tv/console/apps.
TWITCH_CLIENT_ID=

# Server-only secret for app access-token requests.
TWITCH_CLIENT_SECRET=
# ---------------------------------------------------------------------------
# TikTok (optional)
# ---------------------------------------------------------------------------

# Free key from https://www.eulerstream.com/ — raises TikTok signing rate
# limits. Absent, TikTok still works on the shared limit.
TIKTOK_SIGN_API_KEY=

# ---------------------------------------------------------------------------
# Private overlay-usage notifications (required in production)
# ---------------------------------------------------------------------------

# Server-only Discord webhook used by /api/overlay/usage. The browser sends
# only the overlay type, canonical configured channels, page-load event ID,
# navigation action, mode, and an optional shortened random instance ID.
# Never prefix this key with NEXT_PUBLIC_ and never commit its real value.
GXUFY_OVERLAY_USAGE_DISCORD_WEBHOOK_URL=

# Server-only webhook for private abuse-prevention alerts. Raw client IP
# addresses are sent only after repeated rate-limit rejections reach the
# abuse-alert threshold. Keep this webhook in a restricted private channel.
# Never prefix this key with NEXT_PUBLIC_ and never commit its real value.
GXUFY_ABUSE_DISCORD_WEBHOOK_URL=
