# multichat-gxufy — environment variables
#
# Copy to .env.local for development, or paste into the `env` block of
# ecosystem.config.js in production. Names and formats only: this file is
# committed, so it must never contain a real value.
#
# Kick, Twitch, YouTube, TikTok, 7TV, BTTV, and FFZ chat rendering all work
# with channel names alone. The OAuth/storage variables below are optional and
# exist for Twitch's native pinned messages; the final Discord variable is a
# separate server-only production requirement for private usage telemetry.

# ---------------------------------------------------------------------------
# Twitch OAuth (optional — required only for native Twitch pins)
# ---------------------------------------------------------------------------
#
# All six variables in this section are required together. The start endpoint
# checks the whole set before sending anyone to Twitch, so a deployment missing
# any one of them answers /api/twitch/oauth/start with
#
#   {"error":"oauth_not_configured"}
#
# and logs the names of the absent keys. The authoritative list lives in
# lib/server/oauthConfig.ts (REQUIRED_TWITCH_OAUTH_ENV) — if these ever
# disagree, that file is right.

# From https://dev.twitch.tv/console/apps. Public by protocol: it travels in the
# authorize URL the browser follows.
TWITCH_CLIENT_ID=

# From the same application. Server-only, used for the code exchange and token
# refresh. Never sent to the browser.
TWITCH_CLIENT_SECRET=

# Must byte-match an OAuth Redirect URL registered on that Twitch application.
# Twitch compares it character for character and refuses any difference,
# including a trailing slash.
#
#   primary      https://gxufy.com/api/twitch/oauth/callback
#   legacy       https://multichat-gxufy.com/api/twitch/oauth/callback
#   development  http://localhost:3000/api/twitch/oauth/callback
#
# Register all three on the one application; set this to the one this deployment
# serves. The legacy callback stays registered through the cutover so a rollback
# to multichat-gxufy.com needs no Twitch console change.
TWITCH_REDIRECT_URI=

# AES-256-GCM key for tokens at rest — exactly 32 bytes as 64 lowercase hex
# characters, which lib/server/twitchTokenCrypto.ts validates:
#
#   openssl rand -hex 32
#
# Rotating or losing it makes every stored token undecryptable; users reconnect.
TWITCH_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Supabase (the token store — same optional feature)
# ---------------------------------------------------------------------------

# https://<project-ref>.supabase.co
SUPABASE_URL=

# The service-role key, NOT the anon key. Read only inside lib/server/** and
# must never reach the browser. It bypasses RLS, which is why the connections
# table has RLS on with no policies. Schema SQL is in DEPLOY.md.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# TikTok (optional, unrelated to OAuth)
# ---------------------------------------------------------------------------

# Free key from https://www.eulerstream.com/ — raises TikTok signing rate
# limits. Absent, TikTok still works on the shared limit.
TIKTOK_SIGN_API_KEY=

# ---------------------------------------------------------------------------
# Private overlay-usage notifications (required in production)
# ---------------------------------------------------------------------------

# Server-only Discord webhook used by /api/overlay/usage. The browser sends
# only the overlay type, canonical configured channels, page-load event ID,
# navigation action, mode, and an optional shortened random instance ID.
# Never prefix this key with NEXT_PUBLIC_ and never commit its real value.
GXUFY_OVERLAY_USAGE_DISCORD_WEBHOOK_URL=
