		"@vitest/browser-playwright": "^5.1.2",
		"playwright": "^1.65.1",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.4.0",
		"vitest": "^5.1.2",
		"vitest-browser-svelte": "^3.1.0"
